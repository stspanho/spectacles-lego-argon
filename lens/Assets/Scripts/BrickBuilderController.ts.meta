    - "// @input float surfaceDrop = 1 {\"hint\":\"cm to lower the hand-calibrated plane (SurfacePlacement's estimate floats ~1 cm above the table). Negative raises it.\"}"
    - '// @input bool fingerHeight {"hint":"Experimental: table height from the lowest tracked fingertip near the calibration point instead of the fixed drop (sank the area on device when the other hand hung lower)"}'
    - '// @input bool editorSim = true {"hint":"Editor only: plant the table in front of the camera and advance steps on a timer"}'
    - '// @input float editorStepSeconds = 5 {"hint":"Editor only: seconds per build step"}'
